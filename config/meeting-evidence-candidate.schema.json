{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://engineeringwithai.dev/schemas/meeting-evidence-candidate.schema.json",
  "title": "EWAI meeting evidence candidate bundle",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "sourceId",
    "sourceDigest",
    "candidates"
  ],
  "properties": {
    "schema": {
      "const": "ewai.meeting-candidate-bundle/v1"
    },
    "sourceId": {
      "type": "string",
      "pattern": "^meeting\\\\.[a-z0-9][a-z0-9-]{0,59}\\\\.[a-f0-9]{12}$"
    },
    "sourceDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "candidates": {
      "type": "array",
      "minItems": 1,
      "maxItems": 500,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "type",
          "observedStatement",
          "interpretation",
          "lineAnchors",
          "confidence"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^MEC-[0-9]{3,}$"
          },
          "type": {
            "enum": [
              "task",
              "decision",
              "process",
              "risk",
              "system",
              "policy",
              "requirement",
              "assumption",
              "open-question"
            ]
          },
          "observedStatement": {
            "type": "string",
            "minLength": 1,
            "maxLength": 600
          },
          "interpretation": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "lineAnchors": {
            "type": "array",
            "minItems": 1,
            "maxItems": 20,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "start",
                "end"
              ],
              "properties": {
                "start": {
                  "type": "integer",
                  "minimum": 1
                },
                "end": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            }
          },
          "confidence": {
            "enum": [
              "low",
              "medium",
              "high"
            ]
          }
        }
      }
    }
  }
}
