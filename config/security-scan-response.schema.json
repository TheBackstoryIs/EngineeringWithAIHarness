{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://engineeringwithai.dev/schemas/security-scan-response.schema.json",
  "title": "EWAI security scan response",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "runId", "status", "complete", "capabilities", "findings"],
  "properties": {
    "schema": { "const": "ewai.security-scan-response/v1" },
    "runId": { "type": "string", "minLength": 1, "maxLength": 80 },
    "status": { "enum": ["complete", "incomplete", "failed"] },
    "complete": { "type": "boolean" },
    "capabilities": { "type": "array", "minItems": 1, "maxItems": 5, "uniqueItems": true, "items": { "$ref": "#/$defs/capability" } },
    "findings": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "capability", "summary"],
        "properties": {
          "id": { "type": "string", "minLength": 1, "maxLength": 160 },
          "capability": { "$ref": "#/$defs/capability" },
          "severity": { "enum": ["critical", "high", "medium", "low", "info", "unknown"] },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "summary": { "type": "string", "minLength": 1, "maxLength": 1000 },
          "locations": { "$ref": "#/$defs/references" },
          "remediation": { "type": "string", "maxLength": 2000 },
          "evidence": { "$ref": "#/$defs/references" }
        }
      }
    },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "version": { "type": "string", "minLength": 1, "maxLength": 80 }
      }
    },
    "warnings": { "type": "array", "maxItems": 1000, "items": { "type": "string", "minLength": 1, "maxLength": 500 } }
  },
  "$defs": {
    "capability": { "enum": ["source-static", "dependency-sbom", "secret-detection", "infrastructure-configuration", "llm-runtime-red-team"] },
    "references": {
      "type": "array",
      "maxItems": 100,
      "items": { "type": "string", "minLength": 1, "maxLength": 500 }
    }
  }
}
