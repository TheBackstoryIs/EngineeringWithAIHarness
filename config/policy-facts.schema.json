{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://engineeringwith.ai/schemas/policy-facts-v1.json",
  "oneOf": [
    { "$ref": "#/$defs/proposal" },
    { "$ref": "#/$defs/confirmed" }
  ],
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "value": { "type": "string", "minLength": 1, "maxLength": 120, "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$" },
    "dimension": { "enum": ["resource", "operation", "data_entity", "data_classification", "actor", "environment", "destination", "model", "ai_use", "retention"] },
    "intent": {
      "type": "object",
      "required": ["reference", "revision", "digest"],
      "properties": {
        "reference": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*/[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "revision": { "type": "integer", "minimum": 1 },
        "digest": { "$ref": "#/$defs/digest" }
      },
      "additionalProperties": false
    },
    "persona": {
      "type": "object",
      "required": ["id", "name", "tier"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 160 },
        "name": { "type": "string", "minLength": 1, "maxLength": 160 },
        "tier": { "enum": ["core", "personal", "project", "premium"] }
      },
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "required": ["kind", "reference"],
      "properties": {
        "kind": { "enum": ["observed", "model-proposal", "persona-hypothesis"] },
        "reference": { "type": "string", "minLength": 1, "maxLength": 500 },
        "persona": { "$ref": "#/$defs/persona" }
      },
      "additionalProperties": false
    },
    "fact": {
      "type": "object",
      "required": ["id", "dimension", "values", "rationale", "source"],
      "properties": {
        "id": { "$ref": "#/$defs/slug" },
        "dimension": { "$ref": "#/$defs/dimension" },
        "values": { "type": "array", "minItems": 1, "maxItems": 40, "uniqueItems": true, "items": { "$ref": "#/$defs/value" } },
        "rationale": { "type": "string", "minLength": 1, "maxLength": 1200 },
        "source": { "$ref": "#/$defs/source" }
      },
      "additionalProperties": false
    },
    "confirmedFact": {
      "type": "object",
      "required": ["id", "dimension", "values", "rationale", "provenance"],
      "properties": {
        "id": { "$ref": "#/$defs/slug" },
        "dimension": { "$ref": "#/$defs/dimension" },
        "values": { "type": "array", "minItems": 1, "maxItems": 40, "uniqueItems": true, "items": { "$ref": "#/$defs/value" } },
        "rationale": { "type": "string", "minLength": 1, "maxLength": 1200 },
        "provenance": { "$ref": "#/$defs/source" }
      },
      "additionalProperties": false
    },
    "proposal": {
      "type": "object",
      "required": ["schema", "revision", "preparedAt", "intent", "policyDigest", "proposalDigest", "facts", "authority"],
      "properties": {
        "schema": { "const": "ewai.policy-fact-proposal/v1" },
        "revision": { "type": "integer", "minimum": 1 },
        "preparedAt": { "type": "string", "format": "date-time" },
        "intent": { "$ref": "#/$defs/intent" },
        "policyDigest": { "$ref": "#/$defs/digest" },
        "proposalDigest": { "$ref": "#/$defs/digest" },
        "facts": { "type": "array", "minItems": 1, "maxItems": 200, "items": { "$ref": "#/$defs/fact" } },
        "authority": {
          "type": "object",
          "required": ["authoritative", "requiresNamedHumanConfirmation"],
          "properties": {
            "authoritative": { "const": false },
            "requiresNamedHumanConfirmation": { "const": true }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "confirmed": {
      "type": "object",
      "required": ["schema", "revision", "intent", "policyDigest", "proposalDigest", "facts", "confirmation", "authority", "factsDigest"],
      "properties": {
        "schema": { "const": "ewai.confirmed-policy-facts/v1" },
        "revision": { "type": "integer", "minimum": 1 },
        "intent": { "$ref": "#/$defs/intent" },
        "policyDigest": { "$ref": "#/$defs/digest" },
        "proposalDigest": { "$ref": "#/$defs/digest" },
        "factsDigest": { "$ref": "#/$defs/digest" },
        "facts": { "type": "array", "minItems": 1, "maxItems": 200, "items": { "$ref": "#/$defs/confirmedFact" } },
        "confirmation": {
          "type": "object",
          "required": ["confirmedBy", "confirmedAt", "decisions"],
          "properties": {
            "confirmedBy": { "type": "string", "minLength": 1, "maxLength": 160 },
            "confirmedAt": { "type": "string", "format": "date-time" },
            "decisions": {
              "type": "array",
              "minItems": 1,
              "maxItems": 200,
              "items": {
                "type": "object",
                "required": ["factId", "disposition"],
                "properties": {
                  "factId": { "$ref": "#/$defs/slug" },
                  "disposition": { "enum": ["confirmed", "rejected"] },
                  "values": { "type": "array", "minItems": 1, "maxItems": 40, "items": { "$ref": "#/$defs/value" } }
                },
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        },
        "authority": {
          "type": "object",
          "required": ["authoritative", "source", "modelAuthority", "personaAuthority"],
          "properties": {
            "authoritative": { "const": true },
            "source": { "const": "named-human-confirmation" },
            "modelAuthority": { "const": false },
            "personaAuthority": { "const": false }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  }
}
