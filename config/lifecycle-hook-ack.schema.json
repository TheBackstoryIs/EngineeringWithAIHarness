{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://engineeringwithai.dev/schemas/lifecycle-hook-ack/v1",
  "title": "EWAI lifecycle hook acknowledgement",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "status"],
  "properties": {
    "schema": { "const": "ewai.lifecycle-hook-ack/v1" },
    "status": { "enum": ["accepted", "rejected"] },
    "code": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,79}$" },
    "message": { "type": "string", "maxLength": 500 },
    "metadata": {
      "type": "object",
      "maxProperties": 12,
      "additionalProperties": { "type": ["string", "number", "boolean", "null"] }
    }
  }
}
