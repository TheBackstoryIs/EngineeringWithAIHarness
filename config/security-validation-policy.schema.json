{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://engineeringwithai.dev/schemas/security-validation-policy.schema.json",
  "title": "EWAI security validation policy",
  "type": "object",
  "additionalProperties": false,
  "required": ["enabled"],
  "allOf": [
    {
      "if": { "properties": { "enabled": { "const": true } } },
      "then": { "required": ["profiles"] }
    }
  ],
  "properties": {
    "enabled": { "type": "boolean" },
    "profiles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "capability", "required", "freshness_hours", "accountable_role"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,63}$" },
          "capability": { "enum": ["source-static", "dependency-sbom", "secret-detection", "infrastructure-configuration", "llm-runtime-red-team"] },
          "required": { "type": "boolean" },
          "freshness_hours": { "type": "integer", "minimum": 1, "maximum": 8760 },
          "timeout_seconds": { "type": "integer", "minimum": 1, "maximum": 3600 },
          "accountable_role": { "type": "string", "minLength": 1, "maxLength": 120 },
          "modes": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["command", "skill", "artifact-import"] } },
          "provider": { "enum": ["agentic-security", "deepsec", "visa-vvah"] },
          "adapter": { "type": "string", "pattern": "^[a-z][a-z0-9.-]{1,79}$" },
          "checkpoint": { "type": "string", "minLength": 1, "maxLength": 80 },
          "thresholds": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "blocking_severities": {
                "type": "array",
                "minItems": 1,
                "maxItems": 6,
                "uniqueItems": true,
                "items": { "enum": ["critical", "high", "medium", "low", "info", "unknown"] }
              }
            }
          },
          "scope": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "include": { "$ref": "#/$defs/projectPaths" },
              "exclude": { "$ref": "#/$defs/projectPaths" }
            }
          },
          "target_class": { "enum": ["local", "development", "test", "staging", "production"] },
          "target_ref": { "type": "string", "minLength": 1, "maxLength": 160 }
        }
      }
    }
  },
  "$defs": {
    "projectPaths": {
      "type": "array",
      "maxItems": 100,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 240,
        "not": { "pattern": "^(?:/|\\\\|[A-Za-z]:|\\.\\.(?:/|\\\\|$)|.*(?:/|\\\\)\\.\\.(?:/|\\\\|$))" }
      }
    }
  }
}
