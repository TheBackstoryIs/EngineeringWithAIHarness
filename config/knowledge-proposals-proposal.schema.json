{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://engineering-with-ai.local/schemas/knowledge-proposal.json",
  "title": "EWAI knowledge proposal bundle",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "sourceRef", "sourceDigest", "proposals"],
  "properties": {
    "schema": {"const": "ewai.knowledge-proposal-bundle/v1"},
    "sourceRef": {"type": "string", "pattern": "^(meeting-evidence|retrospective):[a-z0-9][a-z0-9.-]{0,119}$"},
    "sourceDigest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "proposals": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "title", "destination", "evidenceAnchors", "rationale", "uncertainty", "relationships", "proposedMarkdown"],
        "properties": {
          "id": {"type": "string", "pattern": "^KNP-[0-9]{3,}$"},
          "kind": {"enum": ["project-persona", "system", "process", "data-concept", "journey", "requirement", "feature-candidate", "risk", "policy", "constraint", "standard", "decision", "pattern", "anti-pattern", "runbook", "sop"]},
          "title": {"type": "string", "minLength": 1, "maxLength": 200},
          "destination": {"type": "string", "minLength": 1, "maxLength": 300},
          "evidenceAnchors": {"type": "array", "minItems": 1, "maxItems": 30, "items": {"type": "string", "minLength": 1, "maxLength": 180}},
          "rationale": {"type": "string", "minLength": 1, "maxLength": 1600},
          "uncertainty": {"type": "string", "maxLength": 1200},
          "relationships": {"type": "array", "maxItems": 30, "items": {"type": "string", "minLength": 1, "maxLength": 300}},
          "proposedMarkdown": {"type": "string", "minLength": 1, "maxLength": 100000}
        }
      }
    }
  }
}
