{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://engineeringwithai.dev/schemas/security-adapter.schema.json",
  "title": "EWAI security adapter manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "name", "publisher", "version", "protocolVersion", "capabilities", "entrypoint"],
  "properties": {
    "schema": { "const": "ewai.security-adapter/v1" },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9.-]{1,79}$" },
    "name": { "type": "string", "minLength": 1, "maxLength": 120 },
    "publisher": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9.-]{1,79}$" },
        "name": { "type": "string", "minLength": 1, "maxLength": 120 }
      }
    },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$" },
    "protocolVersion": { "const": "1" },
    "capabilities": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["source-static", "dependency-sbom", "secret-detection", "infrastructure-configuration", "llm-runtime-red-team"] } },
    "entrypoint": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240,
      "not": { "pattern": "^(?:/|\\\\|[A-Za-z]:|\\.\\.(?:/|\\\\|$)|.*(?:/|\\\\)\\.\\.(?:/|\\\\|$))" }
    }
  }
}
