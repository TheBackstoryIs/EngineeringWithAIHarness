{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://engineeringwith.ai/schemas/pack-v1.json",
  "type": "object",
  "required": ["schema", "id", "name", "version", "type"],
  "properties": {
    "schema": { "const": "ewai.pack/v1" },
    "id": { "type": "string", "pattern": "^(?:ewai\\.[a-z0-9.-]+|org\\.[a-z0-9-]+\\.[a-z0-9.-]+)$" },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "type": { "enum": ["core", "technology", "stack", "persona", "organisation", "design-system"] },
    "requires": { "type": "array", "items": { "type": "string" } },
    "detection": {
      "type": "object",
      "properties": {
        "files": { "type": "array", "items": { "type": "string" } },
        "dependencies": { "type": "array", "items": { "type": "string" } },
        "any_files": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 240, "not": { "pattern": "(^/|^!|[*?]|[\\\\{}()\\[\\]]|(^|/)\\.\\.(/|$))" } } },
        "any_patterns": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 240, "not": { "pattern": "(^/|^!|[\\\\{}()\\[\\]]|(^|/)\\.\\.(/|$))" } } }
      },
      "additionalProperties": false
    },
    "commands": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "deployment": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["target"],
        "properties": {
          "target": { "type": "string" },
          "reference": { "type": "string" }
        }
      }
    },
    "source_map": {
      "type": "object",
      "required": ["profiles"],
      "properties": {
        "profiles": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/sourceMapProfile" }
        }
      },
      "additionalProperties": false
    },
    "boilerplates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "source"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "source": { "type": "string" },
          "version": { "type": "string" },
          "digest": { "type": "string" },
          "notes": { "type": "string" }
        }
      }
    },
    "blueprint": {
      "type": "object",
      "required": ["publisher", "compatibility", "modules"],
      "properties": {
        "publisher": {
          "type": "object",
          "required": ["id", "name"],
          "properties": {
            "id": { "$ref": "#/$defs/slug" },
            "name": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        },
        "compatibility": {
          "type": "object",
          "required": ["ewai"],
          "properties": {
            "ewai": { "type": "string", "pattern": "^[0-9]+\\.x$" }
          },
          "additionalProperties": false
        },
        "modules": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/blueprintModule" }
        }
      },
      "additionalProperties": false
    },
    "design_system": { "$ref": "design-system.schema.json" }
  },
  "$defs": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "contentPath": {
      "type": "string",
      "minLength": 1,
      "not": { "pattern": "(^/|(^|[\\\\/])\\.\\.([\\\\/]|$))" }
    },
    "sourceMapProfile": {
      "type": "object",
      "required": ["id", "patterns", "analyser", "classification"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$" },
        "patterns": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240,
            "not": { "pattern": "(^/|^!|[\\\\{}()\\[\\]]|(^|/)\\.\\.(/|$))" }
          }
        },
        "analyser": { "enum": ["inventory-only", "text-summary", "structured-keys", "tree-sitter", "power-platform-metadata", "salesforce-metadata"] },
        "classification": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "priority": { "type": "integer", "minimum": -10000, "maximum": 10000 },
        "repositories": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "max_bytes": { "type": "integer", "minimum": 1, "maximum": 900000 }
      },
      "additionalProperties": false
    },
    "standard": {
      "type": "object",
      "required": ["id", "title", "source"],
      "properties": {
        "id": { "$ref": "#/$defs/slug" },
        "title": { "type": "string", "minLength": 1 },
        "source": { "$ref": "#/$defs/contentPath" }
      },
      "additionalProperties": false
    },
    "persona": {
      "type": "object",
      "required": ["id", "source"],
      "properties": {
        "id": { "$ref": "#/$defs/slug" },
        "name": { "type": "string", "minLength": 1 },
        "source": { "$ref": "#/$defs/contentPath" }
      },
      "additionalProperties": false
    },
    "policyContribution": {
      "type": "object",
      "required": ["id", "title", "source"],
      "properties": {
        "id": { "$ref": "#/$defs/slug" },
        "title": { "type": "string", "minLength": 1 },
        "source": { "$ref": "#/$defs/contentPath" }
      },
      "additionalProperties": false
    },
    "blueprintBoilerplate": {
      "type": "object",
      "required": ["id", "name", "source", "version", "digest", "licence", "compatibility"],
      "properties": {
        "id": { "$ref": "#/$defs/slug" },
        "name": { "type": "string", "minLength": 1 },
        "source": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "licence": { "type": "string", "minLength": 1 },
        "compatibility": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "starterTarget": {
      "type": "object",
      "required": ["role", "source_path"],
      "properties": {
        "role": { "$ref": "#/$defs/slug" },
        "source_path": { "$ref": "#/$defs/contentPath" }
      },
      "additionalProperties": false
    },
    "blueprintStarterPack": {
      "type": "object",
      "required": ["id", "name", "source", "version", "digest", "licence", "compatibility", "targets"],
      "properties": {
        "id": { "$ref": "#/$defs/slug" },
        "name": { "type": "string", "minLength": 1 },
        "source": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "licence": { "type": "string", "minLength": 1 },
        "compatibility": { "type": "string", "minLength": 1 },
        "targets": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/starterTarget" }
        }
      },
      "additionalProperties": false
    },
    "blueprintModule": {
      "type": "object",
      "required": ["id", "name", "description", "required"],
      "properties": {
        "id": { "$ref": "#/$defs/slug" },
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "required": { "type": "boolean" },
        "standards": { "type": "array", "items": { "$ref": "#/$defs/standard" } },
        "personas": { "type": "array", "items": { "$ref": "#/$defs/persona" } },
        "policies": { "type": "array", "items": { "$ref": "#/$defs/policyContribution" } },
        "design_systems": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^(?:ewai\\.[a-z0-9.-]+|org\\.[a-z0-9-]+\\.[a-z0-9.-]+)$" }
        },
        "starter_packs": { "type": "array", "items": { "$ref": "#/$defs/blueprintStarterPack" } },
        "boilerplates": { "type": "array", "items": { "$ref": "#/$defs/blueprintBoilerplate" } }
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": { "properties": { "type": { "const": "organisation" } }, "required": ["type"] },
      "then": {
        "required": ["description", "blueprint"],
        "properties": {
          "id": { "pattern": "^org\\.[a-z0-9-]+\\.[a-z0-9.-]+$" },
          "requires": { "items": { "pattern": "^org\\.[a-z0-9-]+\\.[a-z0-9.-]+$" } }
        }
      }
    },
    {
      "if": { "properties": { "type": { "const": "design-system" } }, "required": ["type"] },
      "then": {
        "required": ["description", "design_system"],
        "properties": {
          "requires": { "items": { "pattern": "^(?:ewai\\.[a-z0-9.-]+|org\\.[a-z0-9-]+\\.[a-z0-9.-]+)$" } }
        }
      }
    }
  ]
}
