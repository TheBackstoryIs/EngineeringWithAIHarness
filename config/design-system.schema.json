{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://engineeringwith.ai/schemas/design-system-v1.json",
  "type": "object",
  "required": ["compatibility", "provenance", "contributions"],
  "properties": {
    "compatibility": {
      "type": "object",
      "required": ["ewai"],
      "properties": {
        "ewai": { "type": "string", "pattern": "^[0-9]+\\.x$" }
      },
      "additionalProperties": false
    },
    "provenance": {
      "type": "object",
      "required": ["kind", "summary"],
      "properties": {
        "kind": { "enum": ["owner-declared", "observed", "inferred", "adapted"] },
        "summary": { "type": "string", "minLength": 1, "maxLength": 500 },
        "source": { "type": "string", "minLength": 1, "maxLength": 500 }
      },
      "additionalProperties": false
    },
    "contributions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "items": {
        "type": "object",
        "required": ["id", "kind", "title", "source", "applicability", "required"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "kind": { "enum": ["experience", "principles", "foundations", "tokens", "components", "interaction", "content", "states", "responsive", "accessibility", "motion", "prohibited", "review"] },
          "title": { "type": "string", "minLength": 1, "maxLength": 160 },
          "source": { "type": "string", "minLength": 1, "maxLength": 240, "not": { "pattern": "(^[a-zA-Z][a-zA-Z0-9+.-]*:|^/|(^|[\\\\/])\\.\\.([\\\\/]|$))" } },
          "applicability": { "type": "array", "minItems": 1, "maxItems": 30, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" } },
          "required": { "type": "boolean" },
          "replaces": { "type": "array", "maxItems": 30, "uniqueItems": true, "items": { "type": "string", "pattern": "^(?:ewai\\.[a-z0-9.-]+|org\\.[a-z0-9-]+\\.[a-z0-9.-]+):[a-z0-9]+(?:-[a-z0-9]+)*$" } }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
